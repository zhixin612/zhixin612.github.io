<div class="col mb-3">
  <a href="{% if project.redirect %}{{ project.redirect }}{% elsif project.website %}{{ project.website }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        <div class="card-img-wrapper">
          {% include figure.liquid loading="eager" path=project.img sizes="250px" alt="project thumbnail" class="card-img-top" %}
        </div>
      {% endif %}
      <div class="card-body d-flex flex-column py-2 px-3">
        <h3 class="card-title mb-1">{{ project.title }}</h3>
        <p class="card-text flex-grow-1 mb-1">{{ project.description }}</p>
        <div class="card-footer-row">
          {% if project.year %}<span class="card-year">{{ project.year }}</span>{% endif %}
          <span class="card-icons">
            {% if project.github %}
              <span class="github-icon">
                <a href="{{ project.github }}" data-toggle="tooltip" title="Code Repository"><i class="fa-brands fa-github gh-icon"></i></a>
              </span>
            {% endif %}
            {% if project.website %}
              <span class="website-icon">
                <a href="{{ project.website }}" data-toggle="tooltip" title="Project Website"><i class="fa-solid fa-globe"></i></a>
              </span>
            {% endif %}
          </span>
        </div>
      </div>
    </div>
  </a>
</div>
